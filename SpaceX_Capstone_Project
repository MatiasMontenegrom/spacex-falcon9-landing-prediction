        "\n",
        "import folium\n",
        "\n",
        "launch_sites = {\n",
        "    'CCAFS SLC-40': [28.562302, -80.577356],\n",
        "    'KSC LC-39A': [28.608058, -80.603956],\n",
        "    'VAFB SLC-4E': [34.632834, -120.610745],\n",
        "    'CCAFS LC-40': [28.563197, -80.576820]\n",
        "}\n",
        "\n",
        "launch_map = folium.Map(\n",
        "    location=[39, -98],\n",
        "    zoom_start=4,\n",
        "    tiles=\"OpenStreetMap\"\n",
        ")\n",
        "\n",
        "for site, coordinates in launch_sites.items():\n",
        "    folium.Marker(\n",
        "        location=coordinates,\n",
        "        popup=site,\n",
        "        tooltip=site\n",
        "    ).add_to(launch_map)\n",
        "\n",
        "launch_map\n"
      ]
