      "source": [
        "@app.callback(\n",
        "    Output(\"success-pie-chart\", \"figure\"),\n",
        "    Input(\"site-dropdown\", \"value\")\n",
        ")\n",
        "def get_pie_chart(entered_site):\n",
        "    if entered_site == \"ALL\":\n",
        "        # Para todos los sitios: cantidad de lanzamientos exitosos por sitio\n",
        "        success_counts = (\n",
        "            spacex_df[spacex_df[\"class\"] == 1]\n",
        "            .groupby(\"Launch Site\")\n",
        "            .size()\n",
        "            .reset_index(name=\"Launches\")\n",
        "        )\n",
        "        fig = px.pie(\n",
        "            success_counts, values=\"Launches\", names=\"Launch Site\",\n",
        "            title=\"Total Successful Launches by Site\"\n",
        "        )\n",
        "    else:\n",
        "        # Para un sitio específico: comparar éxito y fallo\n",
        "        site_df = spacex_df[spacex_df[\"Launch Site\"] == entered_site]\n",
        "        outcome_counts = (\n",
        "            site_df[\"class\"].value_counts().reindex([1, 0], fill_value=0)\n",
        "            .rename(index={1: \"Success\", 0: \"Failure\"})\n",
        "            .rename_axis(\"Outcome\").reset_index(name=\"Launches\")\n",
        "        )\n",
        "        fig = px.pie(\n",
        "            outcome_counts, values=\"Launches\", names=\"Outcome\",\n",
        "            title=f\"Success vs. Failed Launches — {entered_site}\"\n",
        "        )\n",
        "    return fig\n"
      ]
    },
