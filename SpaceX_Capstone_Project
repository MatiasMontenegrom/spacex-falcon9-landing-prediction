        "# Define coordinates for launch site (CCAFS LC-40) and nearby landmarks\n",
        "launch_site_lat = 28.563197\n",
        "launch_site_lon = -80.576820\n",
        "\n",
        "# Nearby landmarks coordinates (approximate based on geographical data)\n",
        "coastline_coords = [28.56367, -80.56763]   # Closest coastline\n",
        "highway_coords = [28.56321, -80.57079]     # Closest highway (Samuel C Phillips Pkwy)\n",
        "railway_coords = [28.57205, -80.58525]     # Closest railway (NASA Railroad)\n",
        "city_coords = [28.1008, -80.6450]          # Closest city (Melbourne, FL)\n",
        "\n",
        "landmarks = {\n",
        "    'Coastline': coastline_coords,\n",
        "    'Highway': highway_coords,\n",
        "    'Railway': railway_coords,\n",
        "    'City': city_coords\n",
        "}\n",
        "\n",
        "for name, coord in landmarks.items():\n",
        "    # Calculate distance\n",
        "    distance = calculate_distance(launch_site_lat, launch_site_lon, coord[0], coord[1])\n",
        "\n",
        "    # Add a marker displaying the distance\n",
        "    distance_marker = folium.Marker(\n",
        "        location=coord,\n",
        "        icon=DivIcon(\n",
        "            icon_size=(150, 30),\n",
        "            icon_anchor=(0, 0),\n",
        "            html=f'<div style=\"font-size: 12px; color:#d35400;\"><b>{name}: {distance:.2f} KM</b></div>'\n",
        "        )\n",
        "    )\n",
        "    site_map.add_child(distance_marker)\n",
        "\n",
        "    # Draw a line from the launch site to the landmark\n",
        "    line = folium.PolyLine(locations=[[launch_site_lat, launch_site_lon], coord], weight=1.5, color='blue')\n",
        "    site_map.add_child(line)\n",
        "\n",
        "site_map"
      ]
