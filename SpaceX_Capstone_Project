      "source": [
        "# Task 2: Mark the success/failed launches for each site\n",
        "\n",
        "for _, row in spacex_df.iterrows():\n",
        "    coordinate = [row['Lat'], row['Long']]\n",
        "\n",
        "    if row['class'] == 1:\n",
        "        color = 'green'\n",
        "    else:\n",
        "        color = 'red'\n",
        "\n",
        "    folium.CircleMarker(\n",
        "        location=coordinate,\n",
        "        radius=5,\n",
        "        color=color,\n",
        "        fill=True,\n",
        "        fill_opacity=0.8,\n",
        "        popup=f\"Launch Site: {row['Launch Site']} | Class: {row['class']}\"\n",
        "    ).add_to(site_map)\n",
        "\n",
        "site_map"
      ]
    },
